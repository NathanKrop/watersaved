NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-17
# Switch to true after migrating the existing local content into Sanity.
NEXT_PUBLIC_SANITY_CONTENT_AUTHORITATIVE=false
# Optional token required by `npm run import:sanity-seed`.
SANITY_WRITE_TOKEN=

# Server-only Supabase credentials for private get-involved application storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Mailchimp credentials. Never use NEXT_PUBLIC_ for these values.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=